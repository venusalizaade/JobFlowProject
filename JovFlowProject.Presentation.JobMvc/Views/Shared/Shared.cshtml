


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobFlow</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">JobFlow</a>

        <div class="navbar-nav ms-auto">
            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
            <a class="nav-link" asp-controller="Account" asp-action="RegisterJobSeeker">Job Seeker</a>
            <a class="nav-link" asp-controller="Account" asp-action="RegisterEmployer">Employer</a>
        </div>
    </div>
</nav>

<div class="container mt-4">
    @RenderBody()
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

@RenderSection("Scripts", required: false)

</body>
</html>


