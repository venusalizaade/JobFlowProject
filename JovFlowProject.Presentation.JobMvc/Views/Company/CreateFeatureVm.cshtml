@model JovFlowProject.JobMvc.Models.Company.CreateFeatureVm

@{
    ViewData["Title"]="ایجاد امکان";
}


<div class="card shadow">

    <div class="card-body">


        <h3>
            ایجاد امکان جدید
        </h3>


        <form asp-action="Create"
              method="post">


            <div class="mb-3">

                <label asp-for="Name"></label>

                <input asp-for="Name"
                       class="form-control"/>

            </div>


            <div class="mb-3">

                <label asp-for="Price"></label>

                <input asp-for="Price"
                       class="form-control"/>

            </div>


            <div class="mb-3">

                <label asp-for="DurationDays"></label>

                <input asp-for="DurationDays"
                       class="form-control"/>

            </div>


            <div class="mb-3">

                <label asp-for="FeatureType"></label>

                <select asp-for="FeatureType"
                        class="form-select">

                    <option>
                        انتخاب
                    </option>

                </select>

            </div>


            <button class="btn btn-success">
                ثبت
            </button>


        </form>


    </div>

</div>