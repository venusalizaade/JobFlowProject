@model JobFlowProject.Business.Dto.CompanyDto.CompanyResponseDto

@{
    ViewData["Title"] = "Company Details";
}

<div class="card shadow-sm">
    <div class="card-header">
        <h3>@Model.Name</h3>
    </div>
    <div class="card-body">
        <p><strong>National ID:</strong> @Model.NationalId</p>
        <p><strong>Province:</strong> @Model.ProvinceId</p>
        <p><strong>City:</strong> @Model.CityId</p>
        <hr />
        <h5>About</h5>
        <p>@Model.About</p>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-companyId="@Model.CompanyId" class="btn btn-primary">
            Edit
        </a>
    </div>
</div>