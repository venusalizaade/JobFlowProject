@model JovFlowProject.JobMvc.Models.Company.EditFeatureVm

@{
    ViewData["Title"]="ویرایش امکان";
}

<div class="card shadow">

    <div class="card-body">

        <h3>
            ویرایش امکان
        </h3>


        <form asp-action="Edit" method="post">


            <input asp-for="Id" type="hidden"/>


            <div class="mb-3">

                <label asp-for="Name"></label>

                <input asp-for="Name"
                       class="form-control"/>

                <span asp-validation-for="Name"
                      class="text-danger"></span>

            </div>


            <div class="mb-3">

                <label asp-for="Price"></label>

                <input asp-for="Price"
                       class="form-control"/>

            </div>


            <div class="mb-3">

                <label asp-for="DurationDays"></label>

                <input asp-for="DurationDays"
                       class="form-control"/>

            </div>


            <div class="mb-3">

                <label asp-for="FeatureType"></label>

                <select asp-for="FeatureType"
                        class="form-select">

                    <option value="">
                        انتخاب نوع
                    </option>

                </select>

            </div>


            <button class="btn btn-primary">
                ذخیره تغییرات
            </button>


        </form>


    </div>

</div>