@model IEnumerable<JobFlowProject.Business.Dto.Feature.FeatureListDto>

@{
    ViewData["Title"] = "Company Features";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Company Features</h2>
    <a asp-action="Assign" asp-route-companyId="@ViewBag.CompanyId" class="btn btn-primary">Assign Feature</a>
</div>

<table class="table table-bordered">
    <thead>
    <tr>
        <th>Name</th>
        <th>Price</th>
        <th>Duration</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Price</td>
            <td>@item.DurationDays days</td>
        </tr>
    }
    </tbody>
</table>