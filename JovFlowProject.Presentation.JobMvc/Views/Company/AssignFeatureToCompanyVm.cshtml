@model JovFlowProject.JobMvc.Models.Company.AssignFeatureToCompanyVm

@{
    ViewData["Title"]="افزودن امکان";
}


<div class="card shadow">

    <div class="card-body">


        <h3>
            افزودن امکان به شرکت
        </h3>


        <form asp-action="Assign"
              method="post">


            <input asp-for="CompanyId"
                   type="hidden"/>


            <div class="mb-3">


                <label asp-for="FeatureId"></label>


                <select asp-for="FeatureId"
                        class="form-select">


                    <option>
                        انتخاب امکان
                    </option>


                </select>


            </div>


            <button class="btn btn-success">
                ثبت
            </button>


        </form>


    </div>

</div>