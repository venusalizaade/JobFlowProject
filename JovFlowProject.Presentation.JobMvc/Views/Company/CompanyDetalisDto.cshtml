@model dynamic

@{
    ViewData["Title"] = "اطلاعات شرکت";
}

<div class="card shadow">

    <div class="card-body">

        <h2>
            @Model.Name
        </h2>


        @if(Model.LogoUrl != null)
        {
            <img src="@Model.LogoUrl"
                 class="img-thumbnail mb-3"
                 style="width:150px;height:150px;" />
        }


        <hr/>


        <p>
            <strong>آدرس:</strong>
            @Model.Address
        </p>


        <p>
            <strong>درباره شرکت:</strong>
        </p>

        <p>
            @Model.About
        </p>


        <a asp-action="Edit"
           asp-route-companyId="@Model.Id"
           class="btn btn-warning">
            ویرایش شرکت
        </a>


    </div>

</div>