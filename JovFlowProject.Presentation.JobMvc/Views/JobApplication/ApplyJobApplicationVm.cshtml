@model JovFlowProject.JobMvc.Models.Job.CreateJobApplicationVm

@{
    ViewData["Title"]="ارسال درخواست";
}


<div class="card shadow">

    <div class="card-body text-center">


        <h3>
            ارسال درخواست همکاری
        </h3>


        <form asp-action="Apply"
              method="post">


            <input asp-for="JobPostId"
                   type="hidden"/>


            <p>
                آیا برای این موقعیت شغلی درخواست می‌دهید؟
            </p>


            <button class="btn btn-success">
                تایید و ارسال
            </button>


        </form>


    </div>

</div>