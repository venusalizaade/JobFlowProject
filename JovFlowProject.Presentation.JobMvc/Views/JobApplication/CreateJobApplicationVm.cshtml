@model JovFlowProject.JobMvc.Models.Job.CreateJobApplicationVm

@{
    ViewData["Title"] = "Apply for Job";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header">
                <h4 class="mb-0">Apply for Job</h4>
            </div>
            <div class="card-body">
                <form asp-action="Apply" method="post">
                    <input asp-for="JobPostId" type="hidden" />
                    <div class="alert alert-light border">
                        You are about to submit your application.
                    </div>
                    <button type="submit" class="btn btn-success w-100">
                        Submit Application
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>