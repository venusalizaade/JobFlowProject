@model JobFlowProject.Business.Dto.JobPost.JobApplicationDetailDto

@{
    ViewData["Title"] = "Application Details";
}

<div class="card shadow-sm">
    <div class="card-header">
        <h4 class="mb-0">Application Details</h4>
    </div>
    <div class="card-body">
        <p><strong>Job:</strong> @Model.JobTitle</p>
        <p><strong>Company:</strong> @Model.CompanyName</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <p><strong>Applied At:</strong> @Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</p>
    </div>
    <div class="card-footer d-flex justify-content-between">
        <a asp-action="MyApplications" class="btn btn-secondary">Back</a>
        <form asp-action="Cancel" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Cancel Application</button>
        </form>
    </div>
</div>