@model Guid

@{
    ViewData["Title"] = "لغو درخواست";
}


<div class="row justify-content-center">

    <div class="col-md-5">


        <div class="card shadow">


            <div class="card-body text-center">


                <h4 class="mb-4">
                    لغو درخواست همکاری
                </h4>


                <p>
                    آیا مطمئن هستید که می‌خواهید این درخواست را لغو کنید؟
                </p>



                <form asp-action="Cancel"
                      method="post">


                    <input type="hidden"
                           name="id"
                           value="@Model" />


                    <button type="submit"
                            class="btn btn-danger">
                        بله، لغو شود
                    </button>



                    <a asp-action="MyApplications"
                       class="btn btn-secondary">
                        بازگشت
                    </a>


                </form>


            </div>


        </div>


    </div>


</div>