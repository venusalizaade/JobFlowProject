
@model IEnumerable<JobFlowProject.Business.Dto.JobPost.JobPostResponseDto>

@{
    ViewData["Title"] = "Job Posts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Job Posts</h2>
    <a asp-action="Create" class="btn btn-primary">Create Job Post</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No job posts available.</div>
}
else
{
    <div class="row">
        @foreach (var job in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@job.Title</h5>
                        <p class="text-muted">@job.EmploymentType</p>
                        <p>@job.AboutJob</p>

                        @if (job.Salary.HasValue)
                        {
                            <span class="badge bg-success">@job.Salary.Value.ToString("N0")</span>
                        }

                        @if (job.IsFeatured)
                        {
                            <span class="badge bg-warning text-dark">Featured</span>
                        }
                    </div>

                    <div class="card-footer bg-white border-0 d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-primary btn-sm">Details</a>
                        <a asp-controller="JobApplication" asp-action="Apply" asp-route-jobPostId="@job.Id" class="btn btn-success btn-sm">Apply</a>
                    </div>
                </div>
            </div>
        }
    </div>
}