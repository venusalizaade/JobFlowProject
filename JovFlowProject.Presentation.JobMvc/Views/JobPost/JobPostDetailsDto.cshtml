@model JovFlowProject.JobMvc.Models.Job.JobPostDetailsVm

@{
    ViewData["Title"] = "جزئیات شغل";
}


<div class="card shadow">


    <div class="card-body">


        <h2>
            @Model.Title
        </h2>


        <hr/>


        <p>
            <strong>شرکت:</strong>
            @Model.CompanyName
        </p>


        <p>
            <strong>استان:</strong>
            @Model.ProvinceName
        </p>


        <p>
            <strong>شهر:</strong>
            @Model.CityName
        </p>


        <p>
            <strong>دسته بندی:</strong>
            @Model.CategoryName
        </p>


        <p>
            <strong>مهارت:</strong>
            @Model.SkillName
        </p>


        <p>
            <strong>نوع همکاری:</strong>
            @Model.EmploymentType
        </p>


        @if(Model.Salary.HasValue)
        {
            <p>
                <strong>حقوق:</strong>
                @Model.Salary.Value.ToString("N0")
            </p>
        }


        <hr/>


        <h5>
            درباره شغل
        </h5>

        <p>
            @Model.AboutJob
        </p>


        @if(User.Identity?.IsAuthenticated ?? false)
        {

            <a asp-controller="JobApplication"
               asp-action="Apply"
               asp-route-jobPostId="@Model.Id"
               class="btn btn-success">
                ارسال درخواست
            </a>

        }


    </div>

</div>