@model JobFlowProject.Business.Dto.JobPost.JobPostDetailDto
@{
    ViewData["Title"] = "Job Details";
}

<div class="card shadow-sm">
    <div class="card-header">
        <h3>@Model.Title</h3>
    </div>

    <div class="card-body">
        <p><strong>Company:</strong> @Model.CompanyName</p>
        <p><strong>Category:</strong> @Model.CategoryName</p>
        <p><strong>Location:</strong> @Model.CityName, @Model.ProvinceName</p>
        <p><strong>Employment Type:</strong> @Model.EmploymentType</p>

        @if (Model.Salary.HasValue)
        {
            <p><strong>Salary:</strong> @Model.Salary.Value.ToString("N0")</p>
        }

        <hr />

        <h5>About the Job</h5>
        <p>@Model.AboutJob</p>
    </div>

    <div class="card-footer d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-secondary">Back</a>
        <a asp-controller="JobApplication" asp-action="Apply" asp-route-jobPostId="@Model.Id" class="btn btn-success">Apply</a>
    </div>
</div>