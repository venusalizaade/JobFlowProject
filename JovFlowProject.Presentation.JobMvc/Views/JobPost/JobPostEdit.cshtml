@model JovFlowProject.JobMvc.Models.Job.EditJobPostVm

@{
    ViewData["Title"]="ویرایش آگهی";
}


<div class="card shadow">

    <div class="card-body">


        <h3>
            ویرایش آگهی
        </h3>


        <form asp-action="Edit" method="post">


            <input asp-for="Id" type="hidden"/>


            <div class="mb-3">

                <label asp-for="Title"></label>

                <input asp-for="Title"
                       class="form-control"/>

            </div>


            <div class="mb-3">

                <label asp-for="AboutJob"></label>

                <textarea asp-for="AboutJob"
class="form-control"></textarea>

            </div>


            <div class="mb-3">

                <label asp-for="Salary"></label>

                <input asp-for="Salary"
                       class="form-control"/>

            </div>


            <button class="btn btn-primary">
                ذخیره
            </button>


        </form>


    </div>

</div>