
@model JovFlowProject.JobMvc.Models.Job.EditJobPostVm
@{
    ViewData["Title"] = "Edit Job Post";
}

<h2>Edit Job Post</h2>

<form asp-action="Edit" method="post">

    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="AboutJob" class="form-label"></label>
        <textarea asp-for="AboutJob" class="form-control" rows="5"></textarea>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="ProvinceId" class="form-label"></label>
            <input asp-for="ProvinceId" class="form-control" />
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="CityId" class="form-label"></label>
            <input asp-for="CityId" class="form-control" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="EmploymentType" class="form-label"></label>
        <select asp-for="EmploymentType" asp-items="Html.GetEnumSelectList<JobFlowProject.Domain.Enums.EmploymentTypeEnum>()" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="Salary" class="form-label"></label>
        <input asp-for="Salary" class="form-control" />
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <input asp-for="CategoryId" class="form-control" />
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="SkillId" class="form-label"></label>
            <input asp-for="SkillId" class="form-control" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}