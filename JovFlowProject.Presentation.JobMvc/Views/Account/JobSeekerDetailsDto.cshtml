@model JobFlowProject.Business.Dto.User.JobSeekerDetailsDto

@{
    ViewData["Title"] = "Profile";
}

<div class="card shadow-sm">
    <div class="card-header">
        <h3>@Model.FirstName @Model.LastName</h3>
    </div>

    <div class="card-body">
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Phone:</strong> @Model.PhoneNumber</p>
        <p><strong>National ID:</strong> @Model.NationalId</p>
        <p><strong>Gender:</strong> @Model.Gender</p>

        <hr />

        <h5>About</h5>
        <p>@Model.About</p>

        <hr />

        <h5>Resume</h5>

        @if (Model.Attachments.Any())
        {
            <ul class="list-group">
                @foreach (var file in Model.Attachments)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @file.FileName
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No resume uploaded.</p>
        }
    </div>

    <div class="card-footer d-flex justify-content-between">
        <a asp-action="Edit" class="btn btn-primary">Edit Profile</a>

        <form asp-action="UploadResume" method="post" enctype="multipart/form-data" class="d-flex gap-2">
            <input type="file" name="file" class="form-control" />
            <button type="submit" class="btn btn-success">Upload Resume</button>
        </form>
    </div>
</div>