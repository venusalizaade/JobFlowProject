@model JovFlowProject.JobMvc.Models.Accounts.RegisterJobSeekerVm

@{
    ViewData["Title"]="ثبت نام کارجو";
}


<div class="card shadow">

    <div class="card-body">

        <h3 class="mb-4">
            ثبت نام کارجو
        </h3>


        <form asp-action="RegisterJobSeeker" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>


            <div class="row">


                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName"></label>
                    <input asp-for="FirstName" class="form-control"/>
                </div>


                <div class="col-md-6 mb-3">
                    <label asp-for="LastName"></label>
                    <input asp-for="LastName" class="form-control"/>
                </div>


                <div class="col-md-6 mb-3">
                    <label asp-for="NationalId"></label>
                    <input asp-for="NationalId" class="form-control"/>
                </div>


                <div class="col-md-6 mb-3">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control"/>
                </div>


                <div class="col-md-6 mb-3">
                    <label asp-for="PhoneNumber"></label>
                    <input asp-for="PhoneNumber" class="form-control"/>
                </div>


                <div class="col-md-6 mb-3">
                    <label asp-for="Gender"></label>
                    <input asp-for="Gender" class="form-control"/>
                </div>


                <div class="col-md-6 mb-3">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="form-control"/>
                </div>


            </div>


            <button class="btn btn-success">
                ثبت نام
            </button>


        </form>


    </div>
</div>