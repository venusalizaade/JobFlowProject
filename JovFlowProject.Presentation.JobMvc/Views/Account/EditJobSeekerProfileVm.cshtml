@model JovFlowProject.JobMvc.Models.Accounts.EditJobSeekerProfileVm

@{
    ViewData["Title"]="ویرایش پروفایل";
}


<div class="card shadow">

    <div class="card-body">


        <h3>
            ویرایش پروفایل
        </h3>


        <form asp-action="Edit"
              method="post">


            <div class="row">


                <div class="col-md-6 mb-3">

                    <label asp-for="FirstName"></label>

                    <input asp-for="FirstName"
                           class="form-control"/>

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="LastName"></label>

                    <input asp-for="LastName"
                           class="form-control"/>

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="PhoneNumber"></label>

                    <input asp-for="PhoneNumber"
                           class="form-control"/>

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="Gender"></label>

                    <input asp-for="Gender"
                           class="form-control"/>

                </div>


                <div class="col-12 mb-3">

                    <label asp-for="About"></label>

                    <textarea asp-for="About"
class="form-control"
rows="5"></textarea>

                </div>


            </div>


            <button class="btn btn-success">
                ذخیره
            </button>


        </form>


        <hr/>


        <form asp-action="UploadResume"
              method="post"
              enctype="multipart/form-data">


            <label>
                آپلود رزومه
            </label>


            <input type="file"
                   name="file"
                   class="form-control"/>


            <button class="btn btn-primary mt-2">
                ارسال رزومه
            </button>


        </form>


    </div>

</div>