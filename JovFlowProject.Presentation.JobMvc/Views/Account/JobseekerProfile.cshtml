@model dynamic

@{
    ViewData["Title"]="پروفایل";
}


<div class="card shadow">


    <div class="card-body">


        <h3>
            پروفایل کارجو
        </h3>


        <hr/>


        <h5>
            @Model.FirstName @Model.LastName
        </h5>


        <p>
            شماره تماس:
            @Model.PhoneNumber
        </p>


        <p>
            جنسیت:
            @Model.Gender
        </p>


        <p>
            درباره:
        </p>

        <p>
            @Model.About
        </p>



        @if(Model.ResumeUrl != null)
        {

            <a href="@Model.ResumeUrl"
               class="btn btn-info">
                مشاهده رزومه
            </a>

        }


        <a asp-action="Edit"
           class="btn btn-warning">
            ویرایش
        </a>


    </div>


</div>